{
  "openapi": "3.0.3",
  "info": {
    "title": "FerrousCX Contract-First Axum API Service",
    "description": "Contract-First HTTP API Service and SSE real-time streaming hub for the FerrousCX Platform.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/v1/commands/orders/issue-credit": {
      "post": {
        "tags": ["orders"],
        "summary": "Dispatch IssueCourtesyCredit command to intake WAL",
        "description": "Dispatch IssueCourtesyCredit command to intake WAL",
        "operationId": "orders#issue_credit",
        "security": [
          {
            "jwt_bearer": ["api:write"]
          }
        ],
        "requestBody": {
          "description": "Payload for issuing a courtesy credit concession on an order",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueCreditRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Malformed payload or missing required fields",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid JWT token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Insufficient permissions for command dispatch",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity - Semantic validation failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Command dispatch or WAL fsync failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/commands/orders/cancel": {
      "post": {
        "tags": ["orders"],
        "summary": "Dispatch CancelOrder command to intake WAL",
        "description": "Dispatch CancelOrder command to intake WAL",
        "operationId": "orders#cancel_order",
        "security": [
          {
            "jwt_bearer": ["api:write"]
          }
        ],
        "requestBody": {
          "description": "Payload for canceling an existing order",
